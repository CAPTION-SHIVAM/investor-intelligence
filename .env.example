# App
NODE_ENV=development
DEMO_MODE=true
APP_NAME=InvestorIQ
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/investoriq
REDIS_URL=redis://localhost:6379/0

# AI
LLM_PROVIDER=openai
LLM_API_KEY=

# Market data
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=

# News
NEWS_PROVIDER=mock
NEWS_API_KEY=

# Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=investoriq-documents
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email
EMAIL_PROVIDER=mock
EMAIL_API_KEY=

# Monitoring
SENTRY_DSN=

# Security
JWT_SECRET=change-me-in-production
COOKIE_SECRET=change-me-in-production
